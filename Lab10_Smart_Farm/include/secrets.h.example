#pragma once

// =====================================================================
//  secrets.h.example -- แม่แบบสำหรับใส่ชื่อ WiFi และรหัสผ่านของคุณ
//
//  วิธีใช้
//    1) คัดลอกไฟล์นี้เป็น  include/secrets.h   (ชื่อต้องเป็น secrets.h เท่านั้น)
//    2) แก้ค่า WIFI_SSID และ WIFI_PASSWORD ด้านล่างให้เป็นของคุณ
//    3) บันทึกไฟล์ แล้ว upload ใหม่
//
//  ไฟล์ secrets.h ถูกตั้งค่าให้ git "ไม่เก็บ" (ดู .gitignore) รหัสผ่านจะไม่หลุดขึ้น GitHub
//  ห้ามแก้รหัสผ่านจริงลงในไฟล์ .example นี้ เพราะไฟล์นี้ถูกเก็บใน git
//
//  ข้อควรระวัง
//    - ESP32 ใช้ WiFi ย่าน 2.4 GHz เท่านั้น (ไม่รองรับ 5 GHz)
//    - ชื่อ WiFi (SSID) ต้องพิมพ์ให้ตรงทุกตัวอักษร รวมตัวพิมพ์ใหญ่-เล็กและช่องว่าง
// =====================================================================

inline constexpr char WIFI_SSID[] = "";      // ชื่อ WiFi เช่น "MyHomeWiFi"
inline constexpr char WIFI_PASSWORD[] = "";  // รหัสผ่าน WiFi (ถ้าเป็นเครือข่ายเปิด ไม่มีรหัส ให้เว้นว่าง)
